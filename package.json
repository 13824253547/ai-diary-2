{
  "name": "orange-glow-ai-diary",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/app-integrity": "~57.0.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@noble/curves": "1.9.7",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.22",
    "expo-media-library": "~57.0.5",
    "expo-modules-core": "~57.0.18",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./tools/fix-expo-modules-jsi-xcode26.js && node ./tools/prune-ios-motion-apis.cjs",
    "start": "node ./tools/run-dev-process.js metro ./node_modules/.bin/expo start --clear",
    "start:dev-client": "node ./tools/run-dev-process.js metro ./node_modules/.bin/expo start --dev-client --clear",
    "diagnostics:collect": "node ./tools/collect-dev-diagnostics.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild:ios": "expo prebuild --platform ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:domain": "jest --runInBand src/store/__tests__",
    "test:ui": "jest --runInBand src/components",
    "test:contracts": "jest --runInBand src/contracts/__tests__",
    "test:client-secret-boundary": "node --test tools/verify-client-bundle-secrets.test.js"
  },
  "private": true
}
