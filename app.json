{
  "expo": {
    "name": "橙光AI日记",
    "slug": "ai-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ai-diary-2",
    "ios": {
      "bundleIdentifier": "io.com.shihangbiji.www.aidiary",
      "appleTeamId": "JWTMTK2F34",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hjd.aidiary2",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "允许访问你的相册，用来读取你选择的照片并生成回忆日记。",
          "savePhotosPermission": "允许将生成的配图保存到你的系统相册。"
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "a6937efe-e957-4558-92a3-c046aae2b96e"
      }
    },
    "owner": "2317946738",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
