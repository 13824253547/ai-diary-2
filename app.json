{
  "expo": {
    "name": "AI旅行日记",
    "slug": "ai-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ai-diary-2",
    "ios": {
      "bundleIdentifier": "io.com.shihangbiji.www.aidiary",
      "appleTeamId": "JWTMTK2F34",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hjd.aidiary2",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许在日记地点无法识别时补充当前城市，并在筛选同城公开日记时使用城市信息。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许读取你选择的照片，用于AI创作游记或添加到素材库。",
          "savePhotosPermission": "允许将生成的配图和明信片保存到你的系统相册。"
        }
      ],
      "expo-dev-client",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a6937efe-e957-4558-92a3-c046aae2b96e"
      }
    },
    "owner": "2317946738",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
