{
  "name": "orange-glow-ai-diary-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "NODE_ENV=development DATABASE_URL=\"mysql://root:root@127.0.0.1:33306/ai_diary\" REDIS_URL=\"redis://127.0.0.1:36379\" node ../tools/run-dev-process.js backend ./node_modules/.bin/ts-node src/main.ts",
    "start:watch": "NODE_ENV=development DATABASE_URL=\"mysql://root:root@127.0.0.1:33306/ai_diary\" REDIS_URL=\"redis://127.0.0.1:36379\" node ../tools/run-dev-process.js backend node --watch --watch-preserve-output --require ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "DATABASE_URL=\"mysql://root:root@127.0.0.1:33306/ai_diary\" prisma generate",
    "db:push": "DATABASE_URL=\"mysql://root:root@127.0.0.1:33306/ai_diary\" prisma db push --skip-generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:baseline": "ts-node scripts/baseline-prisma-migrations.ts",
    "test:migrations": "sh scripts/verify-prisma-migrations.sh",
    "eval:diary-generation": "ts-node src/scripts/run-diary-generation-evaluation.ts",
    "test": "DATABASE_URL=\"mysql://root:root@127.0.0.1:33306/ai_diary\" REDIS_URL=\"redis://127.0.0.1:36379\" jest --runInBand",
    "test:e2e": "ts-node src/scripts/run-e2e-tests.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "bullmq": "^5.58.5",
    "ioredis": "^5.8.1",
    "multer": "^2.4.0",
    "node-app-attest": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
