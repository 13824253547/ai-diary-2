PORT=3001
DATABASE_URL="mysql://root:root@127.0.0.1:33306/ai_diary"
REDIS_URL="redis://127.0.0.1:36379"
# Local development mock only; production must use a real provider.
AI_PROVIDER="deterministic"
# Optional diary provider override. If empty, a configured PET_CHAT Ark provider is reused first.
DIARY_GENERATION_PROVIDER=""
DIARY_GENERATION_TEMPERATURE="0.7"
DIARY_REWRITE_TEMPERATURE="0.7"
DIARY_GENERATION_MAX_FILE_BYTES="10485760"
DIARY_GENERATION_MAX_TOTAL_BYTES="50331648"
DIARY_GENERATION_TMP_TTL_MS="7200000"
DIARY_GENERATION_CLEANUP_INTERVAL_MS="300000"
DIARY_GENERATION_TMP_DIR=""
# Mount a persistent volume here in deployed environments; otherwise photo files are not durable.
PHOTO_ASSET_STORAGE_DIR=""
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER_MODEL=""
AI_PROVIDER_API_KEY=""
# Hard maximum wait after each provider request is submitted; settings may lower, not raise, the 4-minute cap.
AI_PROVIDER_TIMEOUT_MS="240000"
AI_PROVIDER_MAX_ATTEMPTS="2"
AI_PROVIDER_RESPONSE_FORMAT="json_object"
AI_PROVIDER_GENERATION_TEMPERATURE="0.7"
AI_PROVIDER_REWRITE_TEMPERATURE="0.7"
# Isolated PET-001 provider configuration. Keep the API key server-side.
PET_CHAT_PROVIDER="unconfigured"
PET_CHAT_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
PET_CHAT_MODEL="doubao-seed-character-260628"
PET_CHAT_API_KEY=""
PET_CHAT_TIMEOUT_MS="240000"
PET_CHAT_TEMPERATURE="0.8"
PET_CHAT_MAX_TOKENS="800"
PET_CHAT_HISTORY_ITEMS="12"
# Seedream image generation. The Ark API key falls back to PET_CHAT_API_KEY.
AI_IMAGE_PROVIDER="ark-seedream"
AI_IMAGE_MODEL="doubao-seedream-5-0-flash-260915"
AI_IMAGE_API_KEY=""
AI_IMAGE_TIMEOUT_MS="240000"
AI_IMAGE_SIZE="1.5K"
# In production App Attest is required regardless of this development default.
DEVICE_IDENTITY_MODE="legacy"
APP_ATTEST_TEAM_ID="JWTMTK2F34"
APP_ATTEST_BUNDLE_ID="io.com.shihangbiji.www.aidiary"
APP_ATTEST_CHALLENGES_PER_IP_PER_HOUR="20"
# Generate a unique random value with at least 32 bytes for each deployment.
DEVICE_AUTH_JWT_SECRET=""
